# Puerto de la aplicación
PORT=3000

# Regla de Negocio Parametrizada:
# N = Número de lista del primer integrante por orden alfabético de apellido (García, Santiago)
# Porcentaje de recargo = N * 2%
N_PARAMETRO=7

# Modo de almacenamiento: 'postgres' o 'memory'
STORAGE_TYPE=postgres

# Conexión a Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=taller_turnos
