{
  "name": "taller-final-api-turnos",
  "version": "1.0.0",
  "description": "API REST para gestión de turnos de taller automotriz con arquitectura por capas en Node.js y Express",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
